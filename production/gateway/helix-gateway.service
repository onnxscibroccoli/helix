[Unit]
Description=Helix authenticated OIDC desktop gateway
After=network-online.target helix-libvirt-hypervisor.service
Wants=network-online.target
Requires=helix-libvirt-hypervisor.service
[Service]
Type=simple
User=root
WorkingDirectory=/opt/helix
EnvironmentFile=/etc/helix/gateway.env
EnvironmentFile=-/run/helix-gateway-oidc.env
ExecStartPre=/bin/sh -c 'printf "OIDC_CLIENT_SECRET=%s\\n" "$(/usr/bin/aws cognito-idp describe-user-pool-client --region us-east-1 --user-pool-id us-east-1_40X8yJKI2 --client-id 4co7gd1bo4re206klembj9nr43 --query UserPoolClient.ClientSecret --output text)" > /run/helix-gateway-oidc.env && chmod 600 /run/helix-gateway-oidc.env'
ExecStart=/usr/bin/node /opt/helix/production/gateway/helix-gateway.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/helix
[Install]
WantedBy=multi-user.target
