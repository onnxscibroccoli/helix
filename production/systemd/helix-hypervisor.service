[Unit]
Description=Helix QEMU/libvirt hypervisor gateway
After=libvirtd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helix
Group=libvirt
WorkingDirectory=/opt/helix
Environment=NODE_ENV=production
Environment=HYPERVISOR_PORT=8090
ExecStart=/usr/bin/node /opt/helix/scripts/hypervisor-daemon.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/helix /var/lib/libvirt
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
